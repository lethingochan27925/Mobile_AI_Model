# --- ENV ---
.env/
venv/

# --- Python cache ---
__pycache__/
*/__pycache__/
*.pyc
*.pyo

# --- Ignore only at ROOT (not inside src/) ---
/*.h5
/*.pkl
/*.log
/*.xlsx
/*.csv

# --- Allow these file types inside src ---
!src/*.h5
!src/*.pkl
!src/*.xlsx
!src/*.log
!src/*.csv

# --- System files ---
.DS_Store
Thumbs.db
